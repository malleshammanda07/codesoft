import secrets
import string

def generate_password():
    print("--- Secure Password Generator ---")
    
    try:
        length = int(input("Enter the desired password length (minimum 8 recommended): "))
        if length < 4:
            print("Error: Password length must be at least 4 characters to ensure complexity.")
            return
    except ValueError:
        print("Error: Please enter a valid number for the length.")
        return

    letters = string.ascii_letters
    digits = string.digits
    special = string.punctuation
    
    all_characters = letters + digits + special

    password = [
        secrets.choice(string.ascii_lowercase),
        secrets.choice(string.ascii_uppercase),
        secrets.choice(digits),
        secrets.choice(special)
    ]

    for _ in range(length - 4):
        password.append(secrets.choice(all_characters))

    secrets.SystemRandom().shuffle(password)

    final_password = "".join(password)
    print("\nGenerated Password:")
    print(final_password)

if _name_ == "_main_":
    generate_password()
